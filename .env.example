# ========== PRONOTE ==========
# URL du portail CAS de votre etablissement (ex: https://cas.ent.auvergnerhonealpes.fr/login)
PRONOTE_PORTAL_URL=https://cas.ent.auvergnerhonealpes.fr/login

# Identifiants EduConnect
PRONOTE_EDUCONNECT_USERNAME=votre_identifiant_educonnect
PRONOTE_EDUCONNECT_PASSWORD=votre_mot_de_passe_educonnect

# Profil (eleve, parent, professeur)
PRONOTE_STUDENT_PROFILE=eleve

# Nom de l etablissement dans le portail ENT
PRONOTE_ETABLISSEMENT=Lycée polyvalent

# URL directe vers PRONOTE (optionnel, pour verification)
PRONOTE_DIRECT_URL=zszdqzdqzdzqdq
# ========== NOTION ==========
# Cle API Notion (Integration)
NOTION_API_KEY=your_notion_integration_key

# ID de la base de donnees pour les taches
NOTION_TASK_DATABASE_ID=your_task_database_id

# ID de la source de donnees de la base Taches (API Notion 2025-09-03)
NOTION_TASKS_DATA_SOURCE_ID=qsdqdzqdqzd

# ID de la page projet Lycee
NOTION_LYCEE_PROJECT_PAGE_ID=your_lycee_project_page_id

# ========== MISTRAL / IA ==========
# Activer l'enrichissement par l'IA Mistral (True/False)
AI_ENABLED=True

# Cle API Mistral
MISTRAL_API_KEY=your_mistral_api_key

# Modele Mistral a utiliser
MISTRAL_MODEL=mistral-medium-latest

# ========== OPTIONS ==========
# Mode simulation (True/False) - si True, aucune modification dans Notion
DRY_RUN=False

# Niveau de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Delai entre les requetes Notion (en secondes) pour eviter les rate limits
NOTION_RATE_LIMIT_DELAY=0.35

# Mode headless (True/False) - si False, affiche la fenetre Chrome
HEADLESS=True
